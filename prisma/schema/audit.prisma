model AuditLog {
  id        String    @id @default(uuid()) @db.Uuid
  action    String
  userId    String?   @db.Uuid
  details   Json
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}