model Assessment {
  id              String              @id @default(uuid()) @db.Uuid
  title           String
  description     String?
  durationMinutes Int
  passMarks       Int
  companyId       String              @db.Uuid
  isDeleted       Boolean             @default(false)
  deletedAt       DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  company         CompanyProfile      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  problems        AssessmentProblem[]
  invitations     Invitation[]
  attempts        Attempt[]

  @@index([companyId])
  @@index([isDeleted])
}

model AssessmentProblem {
  assessmentId String     @db.Uuid
  problemId    String     @db.Uuid
  marks        Int
  deletedAt    DateTime?
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  problem      Problem    @relation(fields: [problemId], references: [id], onDelete: Restrict)

  @@id([assessmentId, problemId])
  @@index([problemId])
}

model Invitation {
  id             String           @id @default(uuid()) @db.Uuid
  assessmentId   String           @db.Uuid
  candidateEmail String
  status         InvitationStatus @default(INVITED)
  token          String           @unique
  assessment     Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  attempts       Attempt[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  @@index([assessmentId])
  @@index([candidateEmail])
  @@index([status])
}